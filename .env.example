# Copy to .env and fill in. NEVER commit .env.

# LLM
LLM_PROVIDER=
LLM_API_KEY=
LLM_CHAT_MODEL=
LLM_JUDGE_MODEL=
EMBEDDING_MODEL=

# Database (Postgres + pgvector)
DATABASE_URL=postgresql://user:password@localhost:5432/binhan

# Security
JWT_SECRET=
FIELD_ENCRYPTION_KEY=

# Safety
CRISIS_DETECTOR_TIMEOUT_MS=1500
CASE_SLA_P1_MINUTES=5
CASE_SLA_P2_MINUTES=15

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
